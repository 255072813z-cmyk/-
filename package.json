{
  "name": "online-masjid",
  "private": true,
  "version": "0.1.0",
  "description": "拜毯（Ҷойнамоз / Джойнамоз，原名「网上清真寺」）：给塔吉克斯坦穆斯林的在家礼拜助手（静态网站，无后端、无登录）",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "map": "node scripts/build-map.mjs",
    "quran": "node scripts/fetch-quran.mjs",
    "quran:all": "node scripts/fetch-quran-all.mjs",
    "juz": "node scripts/fetch-juz.mjs",
    "cities": "node scripts/build-cities.mjs",
    "check:times": "node scripts/check-times.mjs",
    "check:astro": "node scripts/check-astronomy.mjs",
    "shots": "node scripts/shots.mjs",
    "verify": "node scripts/verify.mjs",
    "icons": "node scripts/build-icons.mjs",
    "app:sync": "APP_BUILD=1 vite build && cap sync",
    "presence": "node server/dev-server.mjs 8787",
    "admin": "node scripts/build-admin.mjs",
    "test:server": "node server/test-worker.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/local-notifications": "^8.3.1",
    "@fontsource/amiri": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "adhan": "^4.4.6"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "@vitejs/plugin-legacy": "^6.1.1",
    "astronomy-engine": "^2.1.19",
    "geomagnetism": "^0.2.0",
    "terser": "^5.39.0",
    "topojson-client": "^3.1.0",
    "vite": "^6.4.6",
    "world-atlas": "^2.0.2",
    "ws": "^8.18.3"
  }
}
