<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小组件：上面一行城市和"还有多久"，中间下一番的名字和时间，下面五番的时间（下一番加粗、绿色） -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <LinearLayout
        android:id="@+id/w_body"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/w_city"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#5F6B64"
                android:textSize="12sp" />
            <TextView
                android:id="@+id/w_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="#0F5940"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/w_next_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#B08A3A"
                    android:textSize="11sp" />
                <TextView
                    android:id="@+id/w_next_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#1D2B24"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/w_next_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:textColor="#0F5940"
                android:textSize="30sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <LinearLayout style="@style/WidgetCol"><TextView android:id="@+id/w_n0" style="@style/WidgetName" /><TextView android:id="@+id/w_t0" style="@style/WidgetTime" /></LinearLayout>
            <LinearLayout style="@style/WidgetCol"><TextView android:id="@+id/w_n1" style="@style/WidgetName" /><TextView android:id="@+id/w_t1" style="@style/WidgetTime" /></LinearLayout>
            <LinearLayout style="@style/WidgetCol"><TextView android:id="@+id/w_n2" style="@style/WidgetName" /><TextView android:id="@+id/w_t2" style="@style/WidgetTime" /></LinearLayout>
            <LinearLayout style="@style/WidgetCol"><TextView android:id="@+id/w_n3" style="@style/WidgetName" /><TextView android:id="@+id/w_t3" style="@style/WidgetTime" /></LinearLayout>
            <LinearLayout style="@style/WidgetCol"><TextView android:id="@+id/w_n4" style="@style/WidgetName" /><TextView android:id="@+id/w_t4" style="@style/WidgetTime" /></LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/w_empty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="@string/widget_empty"
        android:textColor="#1D2B24"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
